generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerActivityType {
  ORDER_PLACED
  ORDER_DELIVERED
  ORDER_CANCELLED
  POINTS_REDEEMED
  POINTS_EARNED
  MEMBERSHIP_SUBSCRIBED
  MEMBERSHIP_CANCELLED
  ADDRESS_ADDED
  OTHER
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum VariantOption {
  NONE
  PARENT
  VARIANT
}

enum OrderStatus {
  PENDING
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum OrderType {
  SHOP
  MEAT_BOX
  FREEZER_PLANNER
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum ReturnStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  REFUNDED
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PromotionType {
  DISCOUNT_DEAL
  COUPON_CODE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_DELIVERY
}

enum AppliesTo {
  ALL_ORDERS
  CATEGORY
  SPECIFIC_PRODUCTS
}

enum PromotionStatus {
  ACTIVE
  SCHEDULED
  INACTIVE
  EXPIRED
  PAUSED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum MembershipInterval {
  WEEK
  MONTH
  YEAR
}

enum DeliveryFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum DeliveryStatus {
  SCHEDULED
  OUT_FOR_DELIVERY
  DELIVERED
  MISSED
  SKIPPED
}

// ─────────────────────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  passwordHash  String? // null for Google-only users
  emailVerified DateTime?
  image         String?
  role          Role      @default(CUSTOMER)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth
  oauthAccounts       OAuthAccount[]
  passwordResetTokens PasswordResetToken[]

  // Commerce
  addresses      Address[]
  cart           Cart?
  orders         Order[]
  payments       Payment[]
  orderRatings   OrderRating[]
  returnRequests ReturnRequest[]
  notifications  Notification[]

  // Admin
  subscription    Subscription?
  auditLogs       AuditLog[]        @relation("AdminActor")
  sentInvitations AdminInvitation[] @relation("AdminInviter")

  activities      CustomerActivity[]
  customerStatus  CustomerStatus     @default(ACTIVE)
  suspendedAt     DateTime?
  suspendedReason String?
  loyaltyPoints   Int                @default(0)

  @@index([email])
  @@index([role])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String // "google"
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model CustomerActivity {
  id         String               @id @default(cuid())
  userId     String
  type       CustomerActivityType
  title      String // pre-rendered, e.g. "Placed order #LX-10481 — ₦32,400"
  metadata   Json?
  occurredAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
}

// ─────────────────────────────────────────────────────────────
// ADMIN INVITATIONS
// ─────────────────────────────────────────────────────────────

model AdminInvitation {
  id          String    @id @default(cuid())
  email       String
  token       String    @unique
  role        Role      @default(ADMIN)
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  invitedBy User? @relation("AdminInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([token])
}

// ─────────────────────────────────────────────────────────────
// ADDRESSES
// ─────────────────────────────────────────────────────────────

model Address {
  id        String  @id @default(cuid())
  userId    String
  address   String
  region    String
  fullName  String
  phone     String
  phone_sec String?

  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]
  subscription Subscription[]

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// CATEGORIES & PRODUCTS
// ─────────────────────────────────────────────────────────────

model Category {
  id           String         @id @default(cuid())
  name         String         @unique
  slug         String         @unique
  description  String?
  image        String?
  status       CategoryStatus @default(ACTIVE)
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  products   Product[]
  promotions Promotion[]

  @@index([slug])
  @@index([status])
}

model Product {
  id               String        @id @default(cuid())
  code             String        @unique
  name             String
  slug             String        @unique
  description      String?
  shortDescription String?
  images           String[]
  categoryId       String
  sku              String        @unique
  variantOption    VariantOption @default(NONE)
  unitType         String // "pc", "kg", "bag", "tray"
  unitPrice        Decimal       @db.Decimal(12, 2)
  weight           Decimal?      @db.Decimal(10, 3)
  stock            Int           @default(0)
  reorderLevel     Int           @default(5)
  status           ProductStatus @default(ACTIVE)
  isFeatured       Boolean       @default(false)
  tags             String[]
  displayOrder     Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category       Category               @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  promotionLinks PromotionProductLink[]

  @@index([categoryId])
  @@index([slug])
  @@index([status])
  @@index([sku])
  @@index([code])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  label     String // "500g", "1kg"
  sku       String   @unique
  unitPrice Decimal  @db.Decimal(12, 2)
  stock     Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  delta     Int
  reason    String // "order", "restock", "adjustment"
  reference String? // order id
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// CART
// ─────────────────────────────────────────────────────────────

model Cart {
  id     String  @id @default(cuid())
  userId String  @unique
  phone  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

// ─────────────────────────────────────────────────────────────
// PROMOTIONS
// ─────────────────────────────────────────────────────────────

model Promotion {
  id                 String          @id @default(cuid())
  name               String
  type               PromotionType
  discountType       DiscountType
  discountValue      Decimal         @db.Decimal(12, 2)
  appliesTo          AppliesTo
  categoryId         String?
  productIds         String[]        @default([])
  affectedCount      Int             @default(0)
  minimumOrderAmount Decimal?        @db.Decimal(12, 2)
  maximumDiscount    Decimal?        @db.Decimal(12, 2)
  usageLimit         Int?
  usedCount          Int?            @default(30)
  limitPerCustomer   Int?
  code               String?         @unique // only for COUPON_CODE
  startAt            DateTime
  endAt              DateTime?
  status             PromotionStatus @default(SCHEDULED)

  // Aggregate counters kept in sync by the service
  totalProductsAffected Int     @default(0)
  totalDiscountGiven    Decimal @default(0) @db.Decimal(14, 2)
  totalOrdersAffected   Int     @default(0)
  totalSalesMade        Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category     Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orders       Order[]
  productLinks PromotionProductLink[]

  @@index([status])
  @@index([type])
  @@index([startAt, endAt])
  @@index([code])
}

model PromotionProductLink {
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────────────────────

model Order {
  id               String       @id @default(cuid())
  orderNumber      String       @unique // "LX-10482"
  userId           String
  addressId        String?
  promoCodeId      String?
  subtotal         Decimal      @db.Decimal(12, 2)
  discount         Decimal      @default(0) @db.Decimal(12, 2)
  deliveryFee      Decimal      @default(0) @db.Decimal(12, 2)
  total            Decimal      @db.Decimal(12, 2)
  status           OrderStatus  @default(PENDING)
  type             OrderType    @default(SHOP)
  deliveryType     DeliveryType
  deliveryZoneId   String?
  deliveryWindow   String?
  deliveryNotes    String?
  deliveryPhoto    String?
  receiverPhone    String
  receiverName     String
  contactEmail     String?
  /**
   * Snapshot of the address text at order time; Address record may change later
   */
  deliveryAddress  String?
  returnWindowDays Int          @default(7)
  placedAt         DateTime     @default(now())
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  address        Address?        @relation(fields: [addressId], references: [id])
  promoCode      Promotion?      @relation(fields: [promoCodeId], references: [id])
  deliveryZone   DeliveryZone?   @relation(fields: [deliveryZoneId], references: [id])
  items          OrderItem[]
  timeline       Json            @default("[]")
  payments       Payment[]
  rating         OrderRating?
  returnRequests ReturnRequest[]
  notifications  Notification[]

  @@index([userId])
  @@index([status])
  @@index([placedAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  variantId    String?
  productName  String // snapshot
  variantLabel String? // snapshot
  image        String? // snapshot
  unitLabel    String? // snapshot, e.g. "kg"
  unitPrice    Decimal @db.Decimal(12, 2) // snapshot
  quantity     Int
  lineTotal    Decimal @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
}

enum OrderStepId {
  PLACED
  PAYMENT
  PACKED
  OUT_FOR_DELIVERY
  RECEIVED
  RATE
}

enum OrderStepState {
  DONE
  ACTIVE
  PENDING
}

model OrderRating {
  id          String   @id @default(cuid())
  orderId     String   @unique
  userId      String
  stars       Int // 1..5 (validated in service)
  comment     String?
  submittedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ReturnRequest {
  id           String       @id @default(cuid())
  orderId      String
  userId       String
  status       ReturnStatus @default(PENDING_REVIEW)
  reason       String
  /**
   * If empty -> full order return; otherwise specific OrderItem ids
   */
  itemIds      String[]
  refundAmount Decimal?     @db.Decimal(12, 2)
  adminNote    String?
  requestedAt  DateTime     @default(now())
  resolvedAt   DateTime?
  updatedAt    DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

model MembershipPlan {
  id                String             @id @default(cuid())
  slug              String             @unique
  name              String
  description       String?
  price             Decimal            @db.Decimal(12, 2)
  interval          MembershipInterval
  deliveryFrequency DeliveryFrequency
  supply            String[]           @default([]) // the "Weekly supply of:" list
  status            ActiveStatus       @default(ACTIVE)
  displayOrder      Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  subscriptions Subscription[]

  @@index([slug])
  @@index([status])
}

model Protein {
  id           String       @id @default(cuid())
  label        String       @unique
  description  String
  image        String?
  status       ActiveStatus @default(ACTIVE)
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  mixItems ProteinMixItem[]

  @@index([label])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// SUBSCRIPTIONS
// ─────────────────────────────────────────────────────────────

model Subscription {
  id     String             @id @default(cuid())
  userId String             @unique // one active subscription per user (see note)
  planId String
  status SubscriptionStatus @default(PENDING_PAYMENT)

  deliveryFrequency DeliveryFrequency
  deliveryDay       String // "Monday"
  deliveryWindow    String // "8:00 AM – 10:00 AM"

  // Address is snapshotted so plan changes don't affect existing delivery
  addressId String?

  startedAt      DateTime  @default(now())
  nextDeliveryAt DateTime?
  nextBillingAt  DateTime?
  pausedAt       DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  skipUntil      DateTime? // for skip-delivery

  currentDeliveryStatus   DeliveryStatus @default(SCHEDULED)
  /**
   * When staff marked the current delivery.
   */
  currentDeliveryMarkedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  address Address?         @relation(fields: [addressId], references: [id])
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan    MembershipPlan   @relation(fields: [planId], references: [id])
  mix     ProteinMixItem[]

  @@index([status])
  @@index([nextBillingAt])
  @@index([nextDeliveryAt])
}

model ProteinMixItem {
  id             String @id @default(cuid())
  subscriptionId String
  proteinId      String
  percentage     Int // 0-100

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  protein      Protein      @relation(fields: [proteinId], references: [id])

  @@unique([subscriptionId, proteinId])
  @@index([subscriptionId])
}

// ─────────────────────────────────────────────────────────────
// DELIVERY
// ─────────────────────────────────────────────────────────────

model DeliveryZone {
  id            String   @id @default(cuid())
  name          String   @unique
  fee           Decimal  @db.Decimal(12, 2)
  minOrderTotal Decimal? @db.Decimal(12, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]

  @@index([name])
}

// ─────────────────────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────────────────────

model Payment {
  id            String          @id @default(cuid())
  orderId       String?
  userId        String
  provider      PaymentProvider
  providerRef   String          @unique
  amount        Decimal         @db.Decimal(12, 2)
  currency      String          @default("NGN")
  status        PaymentStatus   @default(PENDING)
  failureReason String?
  attemptNumber Int             @default(1)
  metadata      Json?

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  accessCode       String? // Paystack access_code, useful for re-init or debug
  authorizationUrl String? // Paystack authorization_url
  channel          String? // "card", "bank", "ussd", etc.
  paidAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order? @relation(fields: [orderId], references: [id])
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([providerRef])
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  orderId   String?
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  subject   String?
  body      String
  metadata  Json?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// ADMIN AUDIT LOG
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // "product.update", "order.refund"
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AdminActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// SEQUENCE COUNTERS (for PRD-0001, LX-10482, etc.)
// ─────────────────────────────────────────────────────────────

model Counter {
  name  String @id
  value Int    @default(0)
}
